PORT=3003
# Postgres del docker-compose (expuesto en 5403 para no chocar con otros backends)
DATABASE_URL=postgresql://postgres:postgres@localhost:5403/nest_ddd_cqrs

# Mínimo 32 caracteres
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-string
# Segundos
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Origen permitido por CORS (front-vite-fsd)
CORS_ORIGIN=http://localhost:5173

# Contraseña de admin@example.com y user@example.com en `pnpm seed`
SEED_PASSWORD=password123
