{
  "name": "front-next-app-router",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "mock": "prism mock -d ../contract/openapi.yaml -p 4010",
    "gen:api": "openapi-typescript ../contract/openapi.yaml -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "sharp",
      "unrs-resolver"
    ]
  }
}
