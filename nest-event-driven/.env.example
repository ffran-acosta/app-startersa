PORT=3006
# Postgres del docker-compose (expuesto en 5406 para no chocar con otros backends)
DATABASE_URL=postgresql://postgres:postgres@localhost:5406/nest_event_driven
# Redis del docker-compose (broker de eventos, Streams)
REDIS_URL=redis://localhost:6379

# Mínimo 32 caracteres
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-string
# Segundos
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Origen permitido por CORS (front-vite-fsd)
CORS_ORIGIN=http://localhost:5173

# Contraseña de admin@example.com y user@example.com en `pnpm seed`
SEED_PASSWORD=password123
