{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "sourceRoot": "apps/gateway/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": {
              "classValidatorShim": true,
              "introspectComments": false
            }
          }
        ]
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "sourceRoot": "apps/auth/src",
      "entryFile": "main",
      "compilerOptions": { "tsConfigPath": "apps/auth/tsconfig.app.json" }
    },
    "todos": {
      "type": "application",
      "root": "apps/todos",
      "sourceRoot": "apps/todos/src",
      "entryFile": "main",
      "compilerOptions": { "tsConfigPath": "apps/todos/tsconfig.app.json" }
    }
  }
}
