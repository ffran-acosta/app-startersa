# Gateway HTTP
PORT=3005
# Origen permitido por CORS (front-vite-fsd)
CORS_ORIGIN=http://localhost:5173

# Broker del docker-compose
NATS_URL=nats://localhost:4222

# Una DB por servicio, en el Postgres del docker-compose (expuesto en 5405)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5405/auth
TODOS_DATABASE_URL=postgresql://postgres:postgres@localhost:5405/todos

# Lo usan auth (firma) y gateway (verifica). Mínimo 32 caracteres
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-string
# Segundos
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Contraseña de admin@example.com y user@example.com en `pnpm seed`
SEED_PASSWORD=password123
