{
  "name": "nest-microservices",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "postinstall": "prisma generate --config apps/auth/prisma.config.ts && prisma generate --config apps/todos/prisma.config.ts",
    "dev": "concurrently -n gateway,auth,todos -c blue,magenta,green \"nest start gateway --watch\" \"nest start auth --watch\" \"nest start todos --watch\"",
    "build": "nest build gateway && nest build auth && nest build todos",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "migrate": "pnpm migrate:auth && pnpm migrate:todos",
    "migrate:auth": "prisma migrate dev --config apps/auth/prisma.config.ts",
    "migrate:todos": "prisma migrate dev --config apps/todos/prisma.config.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
